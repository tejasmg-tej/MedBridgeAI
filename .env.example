# Copy this file to ".env" (same folder as pom.xml) and fill in your values.
# Do NOT wrap values in quotes. Never commit your real .env file.

# Google Gemini API key (create one at https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Gemini model name. "gemini-flash-latest" always points to the newest Flash model.
# If you want a fixed model, use a name currently listed at https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-flash-latest

# MySQL connection
DB_URL=jdbc:mysql://localhost:3306/medbridge_ai?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your_mysql_password

# Optional
SERVER_PORT=8083
